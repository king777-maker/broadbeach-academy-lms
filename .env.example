# Broadbeach Academy — Environment Configuration Template
# DO NOT commit production values or real secrets to version control.
# Copy this file to .env and configure for your local environment or deployment.

# =========================================================================
# 1. CORE APPLICATION CONFIGURATION
# =========================================================================
VITE_APP_URL=http://localhost:3000
VITE_API_URL=/api
VITE_BASENAME=/

# =========================================================================
# 2. CONFIGURABLE ADMIN OBSCURITY & ACCESS LAYER
# =========================================================================
# Cryptographically random, high-entropy URL path for administrator authentication.
# Requirements:
#   - Must begin with a leading slash ("/")
#   - Must NOT be predictable (e.g., /admin/login, /admin, /secret-admin are strictly rejected)
#   - Minimum 128 bits (16 bytes) of randomness recommended
#
# To automatically generate and rotate a new 160-bit secure URL path, run:
#   node scripts/rotate-admin-path.cjs
VITE_ADMIN_LOGIN_PATH=/secure-console/CHANGE_ME_TO_128_BIT_RANDOM_SECRET_HEX
ADMIN_LOGIN_PATH=/secure-console/CHANGE_ME_TO_128_BIT_RANDOM_SECRET_HEX

# Admin dashboard base path (default: /admin)
VITE_ADMIN_BASE_PATH=/admin
ADMIN_BASE_PATH=/admin
